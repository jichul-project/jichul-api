<?xml version="1.0" encoding="UTF-8"?>

<configuration>
  <springProperty scope="context" name="application" source="spring.application.name"/>
  <springProperty scope="context" name="profiles" source="spring.profiles.active"/>

  <include resource="logback/default/console.xml"/>
  <include resource="logback/default/logger.xml"/>

  <springProfile name="local">
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>

  <springProfile name="main">
    <include resource="logback/default/fluentbit.xml"/>

    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
      <appender-ref ref="FLUENTBIT"/>
    </root>
  </springProfile>

</configuration>